/* Amber CRT: hierarchy via glow intensity, not hue.
   Migrated from ~/Desktop/heading-colors.css — managed by chezmoi,
   edit .chezmoidata/amber-crt.yaml, not this file directly. */
{{ $p := .amber_crt -}}
:root {
    --crt-amber: {{ $p.fg }};
    --crt-dim: .8;
}
body {
    --h1-color: {{ $p.h1 }}; /* brightest, closest to phosphor white */
    --h2-color: {{ $p.h2 }};
    --h3-color: {{ $p.h3 }};
    --h4-color: {{ $p.h4 }};
    --h5-color: {{ $p.h5 }};
    --h6-color: {{ $p.h6 }}; /* dimmest */
    --link-color: var(--crt-amber);
    --tag-color: var(--h3-color);
    --blockquote-color: var(--h5-color);
    --hr-color: var(--h4-color);
}

/* Phosphor glow + gentle CRT flicker on headings */
@keyframes crt-flicker {
    0%, 100% { opacity: 1; }
    92% { opacity: 1; }
    93% { opacity: 0.82; }
    94% { opacity: 1; }
}
.markdown-rendered h1, .markdown-rendered h2, .markdown-rendered h3,
.markdown-rendered h4, .markdown-rendered h5, .markdown-rendered h6 {
    text-shadow: 0 0 4px currentColor, 0 0 10px color-mix(in srgb, currentColor 60%, transparent);
    animation: crt-flicker 6s infinite;
    letter-spacing: 0.02em;
}
.markdown-rendered h1 { text-shadow: 0 0 6px currentColor, 0 0 16px color-mix(in srgb, currentColor 70%, transparent); }
