/* Amber CRT accent throughout the app.
   Migrated from ~/Desktop/extras.css — managed by chezmoi,
   edit .chezmoidata/amber-crt.yaml, not this file directly.
   Note: the source file was missing a closing brace on the last
   rule (.workspace-tab-header.is-active) — added below. */
{{ $p := .amber_crt -}}
body {
    --interactive-accent: {{ $p.fg }};
    --interactive-accent-hover: {{ $p.h1 }};
    --text-accent: {{ $p.fg }};
    --text-accent-hover: {{ $p.h1 }};
    --scrollbar-thumb-bg: rgba(255, 176, 0, 0.35);
    --scrollbar-active-thumb-bg: rgba(255, 176, 0, 0.6);
}

.markdown-preview-view, .cm-scroller { scroll-behavior: smooth; }

/* Scanline overlay across the note area - the core "CRT" effect */
.markdown-preview-view, .cm-editor {
    position: relative;
}
.markdown-preview-view::after, .cm-editor::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
        to bottom,
        rgba(255, 176, 0, 0.035) 0px,
        rgba(255, 176, 0, 0.035) 1px,
        transparent 1px,
        transparent 3px
    );
    mix-blend-mode: overlay;
}

/* Terminal-style code blocks */
code {
    background-color: rgba(255, 176, 0, 0.08);
    color: {{ $p.h1 }};
    border-radius: 2px;
}
.markdown-rendered pre {
    border-left: 3px solid {{ $p.fg }};
    background-color: rgba(20, 15, 0, 0.3);
    box-shadow: 0 0 10px rgba(255, 176, 0, 0.08) inset;
}

/* Blinking amber cursor, like a terminal prompt */
@keyframes crt-cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}
.cm-cursor {
    border-left-color: {{ $p.fg }} !important;
    animation: crt-cursor-blink 1s step-end infinite;
}

/* Checked tasks "power down" */
.markdown-rendered li[data-task="x"] {
    opacity: 0.45;
    text-decoration: line-through;
    filter: grayscale(0.4);
    transition: opacity 0.2s ease, filter 0.2s ease;
}

.internal-link, .tag {
    color: {{ $p.fg }};
    transition: text-shadow 0.15s ease;
}
.internal-link:hover, .tag:hover {
    text-shadow: 0 0 6px {{ $p.fg }};
}
.tag {
    border-radius: 3px;
    background-color: rgba(255, 176, 0, 0.1);
    padding: 0.05em 0.5em;
}

.markdown-rendered blockquote {
    border-left: 3px solid {{ $p.fg }};
    background-color: rgba(255, 176, 0, 0.05);
}

/* Active tab: amber underline glow instead of theme default */
.workspace-tab-header.is-active {
    border-bottom: 2px solid {{ $p.fg }};
    box-shadow: 0 1px 6px rgba(255, 176, 0, 0.4);
}
