{{- $p := .amber_crt -}}
[general]
import = []

[env]
TERM = "xterm-256color"

[terminal]
shell = "zsh"

[font]
normal = { family = "{{ $p.font }}", style = "Regular" }
bold = { family = "{{ $p.font }}", style = "Bold" }
italic = { family = "{{ $p.font }}", style = "Italic" }
bold_italic = { family = "{{ $p.font }}", style = "Bold Italic" }
size = {{ default 14 $p.font_size }}

[font.feature]
"liga" = 1
"calt" = 1

[window]
opacity = {{ $p.opacity }}
padding = { x = 10, y = 10 }
decorations = "Buttonless"
{{- if eq .chezmoi.os "linux" }}
blur = true
{{- end }}

[cursor]
style = { shape = "Beam", blinking = "On" }
unfocused_hollow = true

[colors.primary]
background = "{{ $p.bg }}"
foreground = "{{ $p.fg }}"

[colors.cursor]
text = "{{ $p.bg }}"
cursor = "{{ $p.accent }}"

[colors.selection]
text = "{{ $p.selection_fg }}"
background = "{{ $p.selection_bg }}"

[colors.normal]
black = "{{ $p.black }}"
red = "{{ $p.red }}"
green = "{{ $p.green }}"
yellow = "{{ $p.yellow }}"
blue = "{{ $p.blue }}"
magenta = "{{ $p.magenta }}"
cyan = "{{ $p.cyan }}"
white = "{{ $p.white }}"

[colors.bright]
black = "{{ $p.bright_black }}"
red = "{{ $p.bright_red }}"
green = "{{ $p.bright_green }}"
yellow = "{{ $p.bright_yellow }}"
blue = "{{ $p.bright_blue }}"
magenta = "{{ $p.bright_magenta }}"
cyan = "{{ $p.bright_cyan }}"
white = "{{ $p.bright_white }}"

[mouse]
hide_when_typing = true

[scrolling]
history = 10000

[bell]
animation = "None"

[selection]
semantic_escape_chars = ",│`\":' ()[]{}<>"

[terminal.shell]
{{- if eq .chezmoi.os "windows" }}
program = "powershell.exe"
{{- end }}
