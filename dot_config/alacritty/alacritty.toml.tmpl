{{- $p := .amber -}}
[general]
import = []

[env]
TERM = "xterm-256color"

[terminal]
shell = "zsh"

[font]
normal = { family = "{{ $p.font }}", style = "Regular" }
bold = { family = "{{ $p.font }}", style = "Bold" }
italic = { family = "{{ $p.font }}", style = "Italic" }
bold_italic = { family = "{{ $p.font }}", style = "Bold Italic" }}
size = {{ $p.font_size }}

[font.feature]
"liga" = 1
"calt" = 1

[window]
opacity = {{ $p.opacity }}
padding = { x = 10, y = 10 }
decorations = "Buttonless"
{{- if eq .chezmoi.os "linux" }}
blur = true
{{- end }}

[cursor]
style = { shape = "Beam", blinking = "On" }
unfocused_hollow = true

[colors.primary]
background = "{{ $p.bg }}"
foreground = "{{ $p.fg }}"

[colors.cursor]
text = "{{ $p.bg }}"
cursor = "{{ $p.accent }}"

[colors.selection]
text = "{{ $p.bg }}"
background = "{{ $p.accent }}"

[colors.normal]
black = "{{ $p.color0 }}"
red = "{{ $p.color1 }}"
green = "{{ $p.color2 }}"
yellow = "{{ $p.color3 }}"
blue = "{{ $p.color4 }}"
magenta = "{{ $p.color5 }}"
cyan = "{{ $p.color6 }}"
white = "{{ $p.color7 }}"

[colors.bright]
black = "{{ $p.color8 }}"
red = "{{ $p.color9 }}"
green = "{{ $p.color10 }}"
yellow = "{{ $p.color11 }}"
blue = "{{ $p.color12 }}"
magenta = "{{ $p.color13 }}"
cyan = "{{ $p.color14 }}"
white = "{{ $p.color15 }}"

[mouse]
hide_when_typing = true

[scrolling]
history = 10000

[bell]
animation = "None"

[selection]
semantic_escape_chars = ",│`\":' ()[]{}<>"

[terminal.shell]
{{- if eq .chezmoi.os "windows" }}
program = "powershell.exe"
{{- end }}
