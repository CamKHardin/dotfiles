#!/bin/bash
{{ if eq .chezmoi.os "linux" -}}
if ! command -v ansible-playbook &> /dev/null; then sudo apt-get update && sudo apt-get install -y ansible; fi
ansible-playbook {{ joinPath .chezmoi.sourceDir "ansible/workstation.yml" }} --ask-become-pass
{{ else if eq .chezmoi.os "darwin" -}}
if ! command -v ansible-playbook &> /dev/null; then brew install ansible; fi
ansible-playbook {{ joinPath .chezmoi.sourceDir "ansible/workstation.yml" }} --ask-become-pass
{{ end -}}
